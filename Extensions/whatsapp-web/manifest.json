{
  "id": "superisland.whatsapp-web",
  "name": "WhatsApp Web",
  "version": "1.0.0",
  "minAppVersion": "1.0.0",
  "main": "index.js",
  "author": {
    "name": "SuperIsland"
  },
  "description": "通过二维码配对 WhatsApp Web，并把新消息送到 SuperIsland 通知流。",
  "icon": "icon.svg",
  "license": "MIT",
  "categories": ["communication", "productivity"],
  "permissions": ["network", "notifications"],
  "capabilities": {
    "compact": true,
    "expanded": true,
    "fullExpanded": true,
    "minimalCompact": true,
    "backgroundRefresh": false,
    "settings": true,
    "notificationFeed": true
  },
  "refreshInterval": 60.0,
  "activationTriggers": ["manual"]
}
