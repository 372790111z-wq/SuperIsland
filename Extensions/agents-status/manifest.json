{
  "id": "superisland.agents-status",
  "name": "Agent 状态",
  "version": "1.6.0",
  "minAppVersion": "1.0.0",
  "main": "index.js",
  "author": { "name": "yanlin" },
  "description": "以 5x5 像素动画实时显示 Claude Code 与 Codex CLI 会话状态（工作中 / 等待中 / 空闲 / 错误），并支持多会话聚焦。",
  "icon": "icon.svg",
  "license": "MIT",
  "categories": ["productivity", "dev-tools"],
  "permissions": ["network", "storage", "notifications"],
  "capabilities": {
    "compact": true,
    "expanded": true,
    "fullExpanded": true,
    "minimalCompact": true,
    "backgroundRefresh": true,
    "settings": true
  },
  "refreshInterval": 1.0,
  "activationTriggers": ["manual", "timer"]
}
