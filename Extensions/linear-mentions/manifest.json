{
  "id": "superisland.linear-mentions",
  "name": "Linear 提及",
  "version": "1.0.0",
  "minAppVersion": "1.0.0",
  "main": "index.js",
  "author": {
    "name": "SuperIsland"
  },
  "description": "监听 Linear issue 和评论中的提及，把它们显示在 SuperIsland 中，并支持行内回复。",
  "icon": "icon.svg",
  "license": "MIT",
  "categories": ["productivity", "communication"],
  "permissions": ["network", "notifications", "storage"],
  "capabilities": {
    "compact": true,
    "expanded": true,
    "fullExpanded": true,
    "minimalCompact": true,
    "backgroundRefresh": true,
    "settings": true,
    "notificationFeed": true
  },
  "refreshInterval": 60.0,
  "activationTriggers": ["manual"]
}
